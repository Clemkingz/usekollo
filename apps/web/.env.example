# Copy to .env.local. Names only; never commit real values.

# Horizon (Stellar Testnet) used for balances, history and submitting signed transactions.
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# WalletConnect (Reown) project id for phone wallets (LOBSTR, Varial app). Public; protected by its domain allowlist
# on the Reown dashboard. Without it, phone wallets are hidden and only extension/web wallets are offered.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# NEXT_PUBLIC_SITE_URL=http://localhost:3000
