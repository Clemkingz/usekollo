# Copy to .env.local. Names only; never commit real values.

# UseKollo API (accounts, wallet linking, goals, prepared transactions). Defaults to the production API on Railway.
# The API must allow this site's origin (CORS).
# NEXT_PUBLIC_API_URL=https://usekollo-backend-production-152c5e65.up.railway.app

# WalletConnect (Reown) project id for phone wallets (LOBSTR, Varial app). Public; protected by its domain allowlist
# on the Reown dashboard. Without it, phone wallets are hidden and only extension/web wallets are offered.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# NEXT_PUBLIC_SITE_URL=http://localhost:3000
